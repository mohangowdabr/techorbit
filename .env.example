# TechOrbit Environment Configuration Template

# Next.js Public Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="TechOrbit"

# Supabase Credentials (optional for development - fallback in-memory store active)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transactional Email (Resend)
RESEND_API_KEY=re_your_key_here

# External Integrations (Optional)
GITHUB_API_TOKEN=
DATA_INGESTION_CRON_SECRET=techorbit-cron-secret-token
